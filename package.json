{
  "name": "erechnung-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed finder for German e-invoicing (E-Rechnung) software plans",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "astro sync && tsc --noEmit",
    "validate": "tsx scripts/validate-catalogue.ts",
    "check-sources": "tsx scripts/check-sources.ts",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dataset-summary": "tsx scripts/dataset-summary.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "astro": "^7.4.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
